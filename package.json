{
  "name": "@audroam/outline-fold",
  "version": "0.2.32",
  "description": "Pure TS outline language: parse/serialize, fold-/fold+, sealed payloads, demo crypto, toHtml, createMapView/autoPack. Host owns MFA/key release.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./outline-fold.css": "./dist/outline-fold.css"
  },
  "files": [
    "dist",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-style.mjs",
    "test": "vitest run",
    "smoke:autopack": "node scripts/smoke-autopack.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "demo:react": "npm run build && npm --prefix examples/react-live install && npm --prefix examples/react-live run dev",
    "demo:react:build": "npm run build && npm --prefix examples/react-live install && npm --prefix examples/react-live run build",
    "build:site": "npm run demo:react:build && node scripts/build-site.mjs",
    "build:site:e2e": "VITE_BASE=/audroam-outline-fold/react-live/ npm run build:site",
    "test:e2e": "playwright test",
    "demo:seal": "npm run build && node scripts/generate-demo-sealed.mjs"
  },
  "keywords": [
    "outline",
    "fold",
    "markdown",
    "audroam"
  ],
  "author": "Colin Wirt / Audroam",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colinwirt/audroam-outline-fold.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
